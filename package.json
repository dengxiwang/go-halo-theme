    "swiper": "^14.2.0",
    "terser": "^5.51.2",
    "tocbot": "^4.36.8"
  },
  "devDependencies": {
    "@halo-dev/theme-package-cli": "^1.1.1",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify/tailwind": "^1.2.0",
